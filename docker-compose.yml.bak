services:

mysql:
image: mysql:8.4
container_name: pos-mysql
restart: unless-stopped
environment:
MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
MYSQL_DATABASE: ${MYSQL_DATABASE}
MYSQL_USER: ${MYSQL_USER}
MYSQL_PASSWORD: ${MYSQL_PASSWORD}
volumes:
- mysql_data:/var/lib/mysql
- ./database/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
networks:
- backend
healthcheck:
test:
[
"CMD",
"mysqladmin",
"ping",
"-h",
"localhost",
"-u",
"root",
"-p${MYSQL_ROOT_PASSWORD}"
]
interval: 10s
timeout: 5s
retries: 10

app:
build:
context: ./app
container_name: pos-app
restart: unless-stopped
environment:
APP_PORT: 3000
DB_HOST: mysql
MYSQL_DATABASE: ${MYSQL_DATABASE}
MYSQL_USER: ${MYSQL_USER}
MYSQL_PASSWORD: ${MYSQL_PASSWORD}
depends_on:
mysql:
condition: service_healthy
networks:
- frontend
- backend

phpmyadmin:
image: phpmyadmin:latest
container_name: pos-phpmyadmin
restart: unless-stopped
environment:
PMA_HOST: mysql
PMA_PORT: 3306
depends_on:
mysql:
condition: service_healthy
ports:
- "8080:80"
networks:
- backend

nginx:
image: nginx:alpine
container_name: pos-nginx
restart: unless-stopped
ports:
- "80:80"
volumes:
- ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
depends_on:
- app
networks:
- frontend

cadvisor:
image: gcr.io/cadvisor/cadvisor:v0.52.1
container_name: pos-cadvisor
restart: unless-stopped
volumes:
- /:/rootfs:ro
- /var/run:/var/run:ro
- /sys:/sys:ro
- /var/lib/docker:/var/lib/docker:ro
networks:
- frontend

docker-exporter:
image: ghcr.io/dlepaux/docker-exporter:latest
container_name: pos-docker-exporter
restart: unless-stopped
volumes:
- /var/run/docker.sock:/var/run/docker.sock:ro
networks:
- frontend

prometheus:
image: prom/prometheus:latest
container_name: pos-prometheus
restart: unless-stopped
ports:
- "9090:9090"
volumes:
- ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
- prometheus_data:/prometheus
depends_on:
- cadvisor
networks:
- frontend

grafana:
image: grafana/grafana:latest
container_name: pos-grafana
restart: unless-stopped
ports:
- "3001:3000"
environment:
GF_SECURITY_ADMIN_USER: admin
GF_SECURITY_ADMIN_PASSWORD: ${GF_SECURITY_ADMIN_PASSWORD:-Admin@POS2026!Strong}
volumes:
- grafana_data:/var/lib/grafana
- ./grafana/dashboards:/var/lib/grafana/dashboards:ro
- ./grafana/provisioning:/etc/grafana/provisioning:ro
depends_on:
- prometheus
networks:
- frontend

loki:
image: grafana/loki:latest
container_name: pos-loki
restart: unless-stopped
ports:
- "3100:3100"
volumes:
- ./loki/loki-config.yml:/etc/loki/loki-config.yml:ro
- loki_data:/loki
command: -config.file=/etc/loki/loki-config.yml
networks:
- frontend

promtail:
image: grafana/promtail:latest
container_name: pos-promtail
restart: unless-stopped
volumes:
- ./promtail/promtail-config.yml:/etc/promtail/config.yml:ro
- /var/lib/docker/containers:/var/lib/docker/containers:ro
- /var/run/docker.sock:/var/run/docker.sock:ro
- promtail_data:/tmp
command: -config.file=/etc/promtail/config.yml
depends_on:
- loki
networks:
- frontend

networks:
frontend:
driver: bridge
backend:
driver: bridge

volumes:
mysql_data:
prometheus_data:
grafana_data:
loki_data:
promtail_data:
